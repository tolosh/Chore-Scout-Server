{
  "name": "chore-scout-server",
  "version": "0.1.0",
  "description": "Chore Scout 3.0 server (CS-3941 scaffold)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:jobs": "node dist/jobs-main.js",
    "migrate": "node dist/migrate-main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "schema:check": "tsx scripts/schema-compat.ts"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "fastify": "^5.12.8",
    "graphql": "^16.14.2",
    "mongodb": "^6.22.0",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
