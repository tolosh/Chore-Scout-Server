{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnApiSecretOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-2:932027117528:secret:chore-scout-server/api-??????"
    },
    {
      "Sid": "WriteOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-2:932027117528:log-group:/ecs/chore-scout-server:*"
    },
    {
      "Sid": "EcsExecDiagnosticsDev",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    }
  ]
}
