{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthTokenAccountLevel",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullOwnRepoOnly",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:ap-southeast-2:932027117528:repository/chore-scout-server"
    },
    {
      "Sid": "WriteOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-2:932027117528:log-group:/ecs/chore-scout-server:*"
    }
  ]
}
