#!/usr/bin/env bash
# Test stub for the AWS CLI (CS-3992 deploy.sh tests). Never calls AWS.
set -euo pipefail
echo "aws $*" >>"$STUB_DIR/calls.log"
case "$1 $2" in
  "ecs describe-services")
    # Per-service answer when $STUB_DIR/service-<name>.json exists (jobs deploy tests); else the shared one.
    svc=""; args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do [[ "${args[$i]}" == --services ]] && svc=${args[$((i + 1))]}; done
    if [[ -n "$svc" && -f "$STUB_DIR/service-$svc.json" ]]; then cat "$STUB_DIR/service-$svc.json"; else echo "$STUB_SERVICES_JSON"; fi ;;
  "ecs describe-task-definition")
    # Per-family image when $STUB_DIR/td-image-<family> exists; else the shared rollback image.
    td=""; args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do [[ "${args[$i]}" == --task-definition ]] && td=${args[$((i + 1))]}; done
    fam=${td##*task-definition/}; fam=${fam%%:*}
    if [[ -n "$fam" && -f "$STUB_DIR/td-image-$fam" ]]; then cat "$STUB_DIR/td-image-$fam"; else echo "$STUB_PREV_IMAGE"; fi ;;
  "ec2 describe-security-groups")
    if [[ "${STUB_SG_RC:-0}" != 0 ]]; then
      echo "An error occurred (InvalidGroup.NotFound) when calling the DescribeSecurityGroups operation" >&2
      exit "$STUB_SG_RC"
    fi
    echo "${STUB_SG_NAME:-chore-scout-server-sg}" ;;
  "ecr get-login-password") echo "stub-ecr-token" ;;
  "ecr describe-images")
    if [[ "${STUB_IMAGE_EXISTS:-0}" == 1 || -f "$STUB_DIR/pushed" ]]; then
      echo "$STUB_DIGEST"
    else
      echo "An error occurred (ImageNotFoundException) when calling the DescribeImages operation" >&2
      exit 254
    fi ;;
  "ecs register-task-definition")
    if [[ "${STUB_REGISTER_RC:-0}" != 0 ]]; then
      echo "An error occurred (ClientException) when calling the RegisterTaskDefinition operation" >&2
      exit "$STUB_REGISTER_RC"
    fi
    file=""
    while [[ $# -gt 0 ]]; do
      if [[ "$1" == --cli-input-json ]]; then file=${2#file://}; fi
      shift
    done
    family=$(jq -r .family "$file")
    cp "$file" "$STUB_DIR/registered-$family.json"
    printf '%s\t%s\n' "arn:aws:ecs:ap-southeast-2:932027117528:task-definition/$family:7" "$(jq -r '.containerDefinitions[0].image' "$file")" ;;
  "ecs run-task")
    echo '{"tasks":[{"taskArn":"arn:aws:ecs:ap-southeast-2:932027117528:task/moroku-dsl-dev/0123abcd"}],"failures":[]}' ;;
  "ecs wait")
    if [[ "$3" == services-stable ]]; then exit "${STUB_STABLE_RC:-0}"; fi
    exit "${STUB_TASKS_STOPPED_RC:-0}" ;;
  "ecs describe-tasks")
    jq -n --argjson code "$STUB_MIGRATE_EXIT" \
      '{tasks:[{stoppedReason:"Essential container in task exited",containers:[{name:"chore-scout-migrate",exitCode:$code}]}]}' ;;
  "ecs update-service")
    if [[ " $* " == *" --desired-count "* ]]; then echo "aws stub: update-service must not set --desired-count here: $*" >&2; exit 98; fi
    jq -n --argjson d "$STUB_DESIRED" '{service:{desiredCount:$d}}' ;;
  *) echo "aws stub: unexpected call: $*" >&2; exit 99 ;;
esac
