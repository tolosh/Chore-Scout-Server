# Chore Scout server configuration. Copy to .env for local use; never commit .env.
# Secrets have no defaults anywhere. Start-up exits 78 if a required value is missing.

# Required. Full or short lowercase hex commit SHA; /health reports it.
GIT_SHA=
# Required secret. Local: mongodb://localhost:27017. Deployed: from the secrets store.
MONGODB_URI=
# Required.
MONGODB_DB=chorescout
# Optional: CA bundle for DocumentDB TLS.
MONGODB_TLS_CA_FILE=

# Optional: read secrets (JSON object of KEY -> string) from AWS Secrets Manager.
CS_SECRETS_ID=
AWS_REGION=

PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Pool settings (defaults shown).
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000

# Jobs process only. Required secret there, refused in the API process.
# The one scoped BOB credential: it can only execute recorded Guardian standing authorities (CS-3979).
BOB_ALLOWANCE_CREDENTIAL=
JOB_LEASE_TTL_MS=30000
JOB_TICK_INTERVAL_MS=10000
